#!/usr/bin/env python3
"""Minimal Jira Cloud (REST API v2) CLI. Stdlib only.

Config (non-secret) is read from $JIRA_CONFIG or ~/.config/jira/config.json.
The API token is NEVER stored in the repo. Token resolution order:
  1. $JIRA_API_TOKEN
  2. in-process cache (one `op read` per invocation, however many API calls it makes)
  3. on-disk cache at $JIRA_TOKEN_CACHE or ~/.cache/jira/token, mode 0600, TTL-bound
     (config's token_cache_ttl_seconds or $JIRA_TOKEN_CACHE_TTL, default 900s; 0 disables)
  4. `op read <op_token_ref>`   (1Password, ref taken from config) -- result written to
     the on-disk cache for the next invocation

Commands:
  jira me                              # whoami (auth check)
  jira mine                            # my open issues
  jira sprint                          # my issues in the current open sprint
  jira search 'JQL'                    # arbitrary JQL
  jira issue KEY                       # one issue: fields + description + recent comments
  jira comments KEY                    # comments only
  jira comment KEY "text"              # add a comment
  jira transition KEY "In Progress"    # move status (matched by name)
  jira assign KEY [me|ACCOUNT_ID]      # (re)assign; default me
  jira worklog KEY --dur MIN [--comment "..."]
  jira sprint-add KEY                  # add issue to the board's active sprint
  jira create "summary" [--project KEY] [--type Task] [--parent KEY] [--description "..."]

Add --json to any command for the raw API object.

REST v2 (not v3) is used deliberately: comment/description bodies are plain
strings, not the v3 ADF JSON tree.
"""
import argparse
import base64
import json
import os
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_FILE = os.path.expanduser(os.environ.get("JIRA_CONFIG", "~/.config/jira/config.json"))
REQUEST_TIMEOUT = 15  # seconds, for both HTTP calls and `op read`
_token_cache = None  # resolved once per process; every request()/agile_request() call reuses it

_default_cache_dir = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "jira"
)
TOKEN_CACHE_FILE = os.path.expanduser(
    os.environ.get("JIRA_TOKEN_CACHE", os.path.join(_default_cache_dir, "token"))
)
DEFAULT_TOKEN_CACHE_TTL = 900  # seconds; keeps a burst of commands from re-prompting 1Password


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def load_config():
    if not os.path.exists(CONFIG_FILE):
        die(f"no config at {CONFIG_FILE} (copy config.example.json there and fill it in)")
    try:
        with open(CONFIG_FILE) as f:
            cfg = json.load(f)
    except ValueError as e:
        die(f"config {CONFIG_FILE} is not valid JSON: {e}")
    for k in ("site", "email"):
        if not cfg.get(k):
            die(f"config missing required key {k!r}")
    return cfg


def _token_cache_ttl(cfg):
    env = os.environ.get("JIRA_TOKEN_CACHE_TTL")
    if env is not None:
        try:
            return int(env)
        except ValueError:
            pass
    return cfg.get("token_cache_ttl_seconds", DEFAULT_TOKEN_CACHE_TTL)


def _read_token_cache(cfg, ref):
    """Best-effort read; any problem just means 'no usable cache', never an error."""
    ttl = _token_cache_ttl(cfg)
    if ttl <= 0:
        return None
    try:
        with open(TOKEN_CACHE_FILE) as f:
            data = json.load(f)
        if data.get("op_token_ref") != ref:
            return None
        if time.time() - float(data["resolved_at"]) >= ttl:
            return None
        tok = data.get("token")
        return tok.strip() if tok else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def _write_token_cache(token, ref):
    """Best-effort write; a failure here should never break the command itself."""
    try:
        cache_dir = os.path.dirname(TOKEN_CACHE_FILE)
        os.makedirs(cache_dir, exist_ok=True)
        os.chmod(cache_dir, 0o700)
        fd, tmp_path = tempfile.mkstemp(dir=cache_dir)
        try:
            os.chmod(tmp_path, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump({"token": token, "op_token_ref": ref, "resolved_at": time.time()}, f)
            os.replace(tmp_path, TOKEN_CACHE_FILE)
        except BaseException:
            os.unlink(tmp_path)
            raise
    except OSError:
        pass


def get_token(cfg):
    global _token_cache
    if _token_cache is not None:
        return _token_cache
    tok = os.environ.get("JIRA_API_TOKEN")
    if tok:
        _token_cache = tok.strip()
        return _token_cache
    ref = cfg.get("op_token_ref")
    cached = _read_token_cache(cfg, ref) if ref else None
    if cached:
        _token_cache = cached
        return _token_cache
    if ref:
        try:
            out = subprocess.run(
                ["op", "read", ref], capture_output=True, text=True, check=True,
                timeout=REQUEST_TIMEOUT,
            )
            _token_cache = out.stdout.strip()
            if _token_cache_ttl(cfg) > 0:
                _write_token_cache(_token_cache, ref)
            return _token_cache
        except FileNotFoundError:
            die("op CLI not found, and $JIRA_API_TOKEN is unset")
        except subprocess.TimeoutExpired:
            die(f"`op read {ref}` timed out after {REQUEST_TIMEOUT}s")
        except subprocess.CalledProcessError as e:
            die(f"`op read {ref}` failed: {(e.stderr or '').strip()}")
    die("no token: set $JIRA_API_TOKEN or set 'op_token_ref' in config")


def request(cfg, method, path, body=None, params=None, api="2"):
    tok = get_token(cfg)
    auth = base64.b64encode(f"{cfg['email']}:{tok}".encode()).decode()
    url = f"https://{cfg['site']}/rest/api/{api}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Basic {auth}")
    req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        die(f"HTTP {e.code} on {method} {url}: {detail}")
    except urllib.error.URLError as e:
        die(f"connection failed: {e.reason}")


def agile_request(cfg, method, path, body=None, params=None):
    """Jira Agile API (boards/sprints) lives under a different base path."""
    tok = get_token(cfg)
    auth = base64.b64encode(f"{cfg['email']}:{tok}".encode()).decode()
    url = f"https://{cfg['site']}/rest/agile/1.0{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Basic {auth}")
    req.add_header("Content-Type", "application/json")
    req.add_header("Accept", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as resp:
            raw = resp.read().decode()
            return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        die(f"HTTP {e.code} on {method} {url}: {detail}")
    except urllib.error.URLError as e:
        die(f"connection failed: {e.reason}")


# --- helpers ---------------------------------------------------------------

TABLE_FIELDS = "summary,status,priority,updated,assignee"


def _q(v):
    """Escape a value for use as a single URL path segment."""
    return urllib.parse.quote(str(v), safe="")


def _search(cfg, jql, fields=TABLE_FIELDS, max_results=1000, page_size=100):
    # /rest/api/2/search was removed (Atlassian CHANGE-2046); use the v3
    # enhanced-search endpoint: POST /search/jql, fields as an array. That
    # endpoint paginates via nextPageToken/isLast rather than startAt/total,
    # so loop until either is exhausted or we hit max_results.
    issues = []
    next_token = None
    while True:
        body = {"jql": jql, "fields": fields.split(","), "maxResults": page_size}
        if next_token:
            body["nextPageToken"] = next_token
        res = request(cfg, "POST", "/search/jql", body=body, api="3") or {}
        issues.extend(res.get("issues", []))
        next_token = res.get("nextPageToken")
        if len(issues) >= max_results or res.get("isLast", True) or not next_token:
            break
    if len(issues) > max_results:
        issues = issues[:max_results]
        print(f"warning: results capped at {max_results}; more may exist", file=sys.stderr)
    return issues


def _fmt_row(it):
    f = it.get("fields", {})
    key = it.get("key", "?")
    status = (f.get("status") or {}).get("name", "?")
    pri = (f.get("priority") or {}).get("name", "-")
    upd = (f.get("updated") or "")[:10]
    summ = f.get("summary", "")
    return f"{key}\t{status}\t{pri}\t{upd}\t{summ}"


def _rows(issues):
    return "\n".join(_fmt_row(i) for i in issues) or "(no issues)"


def emit(args, human, obj):
    if getattr(args, "json", False):
        print(json.dumps(obj, indent=2, default=str))
    else:
        print(human)


def _resolve_who(cfg, who):
    if who in (None, "me"):
        return cfg.get("account_self") or die("no 'account_self' in config for 'me'")
    return who


# --- commands --------------------------------------------------------------

def cmd_me(args):
    cfg = load_config()
    me = request(cfg, "GET", "/myself")
    emit(args, f"{me.get('displayName')} <{me.get('emailAddress')}>  {me.get('accountId')}", me)


def cmd_mine(args):
    cfg = load_config()
    jql = "assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC"
    issues = _search(cfg, jql)
    emit(args, _rows(issues), issues)


def cmd_sprint(args):
    cfg = load_config()
    jql = ("assignee = currentUser() AND sprint IN openSprints() "
           "AND statusCategory != Done ORDER BY updated DESC")
    issues = _search(cfg, jql)
    emit(args, _rows(issues), issues)


def cmd_search(args):
    cfg = load_config()
    issues = _search(cfg, args.jql, max_results=args.max)
    emit(args, _rows(issues), issues)


def _fmt_comment(c):
    author = (c.get("author") or {}).get("displayName", "?")
    when = (c.get("created") or "")[:16].replace("T", " ")
    body = (c.get("body") or "").strip()
    return f"[{when}] {author}:\n{body}"


def cmd_issue(args):
    cfg = load_config()
    it = request(cfg, "GET", f"/issue/{_q(args.key)}", params={
        "fields": "summary,status,priority,assignee,reporter,updated,description,comment",
    })
    f = it.get("fields", {})
    assignee = (f.get("assignee") or {}).get("displayName", "Unassigned")
    status = (f.get("status") or {}).get("name", "?")
    pri = (f.get("priority") or {}).get("name", "-")
    comments = ((f.get("comment") or {}).get("comments")) or []
    tail = comments[-3:]
    human = (
        f"{it.get('key')}  {f.get('summary','')}\n"
        f"status: {status}   priority: {pri}   assignee: {assignee}   "
        f"updated: {(f.get('updated') or '')[:16].replace('T',' ')}\n\n"
        f"{(f.get('description') or '(no description)').strip()}\n"
    )
    if tail:
        human += f"\n--- last {len(tail)} of {len(comments)} comment(s) ---\n"
        human += "\n\n".join(_fmt_comment(c) for c in tail)
    emit(args, human, it)


def cmd_comments(args):
    cfg = load_config()
    res = request(cfg, "GET", f"/issue/{_q(args.key)}/comment")
    comments = res.get("comments", []) if res else []
    human = "\n\n".join(_fmt_comment(c) for c in comments) or "(no comments)"
    emit(args, human, comments)


def cmd_comment(args):
    cfg = load_config()
    c = request(cfg, "POST", f"/issue/{_q(args.key)}/comment", body={"body": args.text})
    emit(args, f"commented on {args.key} (id {c.get('id')})", c)


def cmd_transition(args):
    cfg = load_config()
    res = request(cfg, "GET", f"/issue/{_q(args.key)}/transitions")
    trans = res.get("transitions", []) if res else []
    want = args.state.lower()
    match = None
    for t in trans:
        to_name = (t.get("to") or {}).get("name", "")
        if t.get("name", "").lower() == want or to_name.lower() == want:
            match = t
            break
    if not match:
        avail = ", ".join(f"{t.get('name')}→{(t.get('to') or {}).get('name')}" for t in trans)
        die(f"no transition matching {args.state!r} on {args.key}. available: {avail}")
    request(cfg, "POST", f"/issue/{_q(args.key)}/transitions",
            body={"transition": {"id": match["id"]}})
    emit(args, f"{args.key} → {(match.get('to') or {}).get('name')}", match)


def cmd_assign(args):
    cfg = load_config()
    acct = _resolve_who(cfg, args.who)
    request(cfg, "PUT", f"/issue/{_q(args.key)}/assignee", body={"accountId": acct})
    emit(args, f"{args.key} assigned to {acct}", {"key": args.key, "accountId": acct})


def cmd_worklog(args):
    cfg = load_config()
    body = {"timeSpentSeconds": int(args.dur) * 60}
    if args.comment:
        body["comment"] = args.comment
    w = request(cfg, "POST", f"/issue/{_q(args.key)}/worklog", body=body)
    emit(args, f"logged {args.dur}m on {args.key} (id {w.get('id')})", w)


def cmd_create(args):
    cfg = load_config()
    project = args.project or cfg.get("default_project") or die(
        "no project: pass --project or set 'default_project' in config"
    )
    fields = {
        "project": {"key": project},
        "issuetype": {"name": args.type},
        "summary": args.summary,
    }
    if args.description:
        fields["description"] = args.description
    if args.parent:
        fields["parent"] = {"key": args.parent}
    it = request(cfg, "POST", "/issue", body={"fields": fields})
    emit(args, f"created {it.get('key')}", it)


def cmd_sprint_add(args):
    cfg = load_config()
    board = cfg.get("board_id")
    if not board:
        die("no 'board_id' in config; needed to find the active sprint")
    res = agile_request(cfg, "GET", f"/board/{_q(board)}/sprint", params={"state": "active"})
    sprints = res.get("values", []) if res else []
    if not sprints:
        die(f"no active sprint on board {board}")
    sid = sprints[0]["id"]
    agile_request(cfg, "POST", f"/sprint/{_q(sid)}/issue", body={"issues": [args.key]})
    emit(args, f"{args.key} added to sprint {sprints[0].get('name')} (id {sid})",
         {"key": args.key, "sprint": sid})


def main():
    # --json is defined on this shared parent AND passed to every subparser
    # below, so it parses in either position: `jira --json mine` or
    # `jira mine --json`.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="raw API output")

    p = argparse.ArgumentParser(
        prog="jira", description="Minimal Jira Cloud v2 CLI", parents=[common]
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("me", parents=[common]).set_defaults(func=cmd_me)
    sub.add_parser("mine", parents=[common]).set_defaults(func=cmd_mine)
    sub.add_parser("sprint", parents=[common]).set_defaults(func=cmd_sprint)

    sp = sub.add_parser("search", parents=[common])
    sp.add_argument("jql")
    sp.add_argument("--max", type=int, default=50)
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("issue", parents=[common])
    sp.add_argument("key")
    sp.set_defaults(func=cmd_issue)

    sp = sub.add_parser("comments", parents=[common])
    sp.add_argument("key")
    sp.set_defaults(func=cmd_comments)

    sp = sub.add_parser("comment", parents=[common])
    sp.add_argument("key")
    sp.add_argument("text")
    sp.set_defaults(func=cmd_comment)

    sp = sub.add_parser("transition", parents=[common])
    sp.add_argument("key")
    sp.add_argument("state")
    sp.set_defaults(func=cmd_transition)

    sp = sub.add_parser("assign", parents=[common])
    sp.add_argument("key")
    sp.add_argument("who", nargs="?", default="me")
    sp.set_defaults(func=cmd_assign)

    sp = sub.add_parser("worklog", parents=[common])
    sp.add_argument("key")
    sp.add_argument("--dur", required=True, help="minutes")
    sp.add_argument("--comment")
    sp.set_defaults(func=cmd_worklog)

    sp = sub.add_parser("sprint-add", parents=[common])
    sp.add_argument("key")
    sp.set_defaults(func=cmd_sprint_add)

    sp = sub.add_parser("create", parents=[common])
    sp.add_argument("summary")
    sp.add_argument("--project", help="defaults to config's default_project")
    sp.add_argument("--type", default="Task", help="issue type name (default: Task)")
    sp.add_argument("--description")
    sp.add_argument("--parent", help="parent issue key (e.g. an Epic)")
    sp.set_defaults(func=cmd_create)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
